#!/usr/bin/env bash
# bin/prime — the one command that proves the docs site still builds.
#
#   bin/prime             # npm ci, the build, the offline suite
#   bin/prime --contracts # the above, plus the tier that reads core and caf
#   bin/prime --fast      # npm ci only
#
# WHAT IT PROMISES
#   Exit 0: the lockfile installs, the site builds, and every page the sidebar
#   links to exists in dist/. Anything else: nonzero, with the failing step
#   named. `set -euo pipefail` is the whole mechanism.
#
# WHY `npm ci` AND NOT `npm install`
#   `ci` installs exactly package-lock.json and fails when the lock and the
#   manifest disagree. `install` would quietly rewrite the lock and let two
#   worktrees disagree about one commit.
#
# WHY THE BUILD IS THE GATE
#   This repository has no runtime to exercise. Starlight validates every
#   page's frontmatter and Astro checks every content collection, so a red
#   build is the real test — tests/smoke.mjs then proves the build produced the
#   pages the navigation promises.
#
# THE TWO TIERS, and why there are two
#   `npm test` runs the **offline tier**: no network, no sibling checkout, no
#   toolchain beyond node and bash. That is deliberate. A gate that needs the
#   internet is a gate that fails in CI for reasons unrelated to the change, and
#   a contributor with no `core` beside their worktree cannot run the thing that
#   is supposed to stop them committing.
#
#   `--contracts` adds the **contract tier** (tests/contracts.mjs), which is
#   the only tier that can catch an example contradicting a *shipped* contract:
#   the `cafaye.yml` examples run through the real `caf contract lint` against
#   core's real schema, and the event types and span names the prose asserts
#   are checked against core's catalog and core's span-naming schema. It needs a
#   readable `core` (CORE_PATH, or a sibling checkout) and a `caf` binary.
#
#   It is a flag and not the default because those two prerequisites are real,
#   and it is a *separate file* rather than a skip because the alternative is
#   worse: a contract check that quietly does nothing when it cannot find the
#   contract converts an unknown into a green badge. CI runs it as its own job
#   and fails the build if this tier did not run. See AGENTS.md.

set -euo pipefail

FAST=0
CONTRACTS=0
for arg in "$@"; do
  case "$arg" in
    --fast) FAST=1 ;;
    --contracts) CONTRACTS=1 ;;
    -h | --help)
      sed -n '2,10p' "$0"
      exit 0
      ;;
    *)
      echo "bin/prime: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "bin/prime: $1 not found on PATH — run 'mise install' in this worktree" >&2
    exit 127
  fi
}

step() {
  printf '\n== %s\n' "$1"
}

version_of() {
  "$@" --version 2>/dev/null | head -n 1 || true
}

require node
require npm

step "npm ci"
npm ci

if [ "$FAST" -eq 1 ]; then
  step "skipping build and tests (--fast)"
  exit 0
fi

step "npm run build"
npm run build

step "npm test"
npm test

if [ "$CONTRACTS" -eq 1 ]; then
  step "npm run test:contracts (needs CORE_PATH and a caf binary)"
  npm run test:contracts
else
  step "skipping the contract tier (--contracts); it did NOT run"
  echo "   Every claim about a shipped contract is UNCHECKED in this run."
  echo "   Run 'bin/prime --contracts', or 'mise run prime:contracts'."
fi

version="$(version_of node)"
step "prime ok (node ${version:-unknown})"